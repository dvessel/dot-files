#!/usr/bin/env zsh

set -e

zparseopts -D -E - {-formula,-formulae,-cask}=_pkgdef

# conditional output based on the homebrew package definition being worked on.
# example: `c.pkgdef output-for-formula output-for-cask`
#   if `--formula` is passed to this script, `output-for-formula` will be output.
function c.pkgdef {
  print -- ${${pkgdef/--formula/$1}/--cask/$2}
}
# will be either --formula or --cask.
pkgdef=${${_pkgdef:---formula}/--formulae/--formula}

brew_commands_any=(
  install info uses deps desc fetch cleanup options home homepage log
  audit cat formula livecheck style unbottled unpack
)
brew_commands_installed=(
  reinstall uninstall remove rm outdated upgrade postinstall missing
  list ls link ln unlink pin unpin edit migrate gist-logs bottle linkage test
  --prefix --cellar --cache
)
brew_commands=( $brew_commands_any $brew_commands_installed )

cask_incompatible=(
  link ln unlink gist-logs migrate missing options bottle formula linkage test
  pin unpin unbottled unpack --prefix --cellar
)
if [[ $pkgdef == --cask ]]
then
  brew_commands=( ${brew_commands:|cask_incompatible} )
fi
# Single select commands for fzf single select mode.
no_multi=( log gist-logs migrate )

if (( $brew_commands[(I)$1] ))
then
  brew_args=( $@ )
elif [[ $1 == (--formula|--cask) && -z ${(@)argv:*brew_commands} || -z $@ ]]
then
  brew_args=( info $@ )
elif [[ -n ${(@)argv:*brew_commands} ]]
then
  printf "Did you mean \`%s\`?\n" "${(@)argv:*brew_commands} $pkgdef" >&2
  exit 1
else
  printf "Supported \`%s\` commands:\n%s [See brew --help]\n" \
    "$pkgdef" "${(j[, ])brew_commands}" >&2
  exit 1
fi

names=$( brew --cache )/api/$( c.pkgdef formula_names cask_names )
fzf_list_txt=$( brew --cache )/fzf${pkgdef}-list-$( uname -m ).txt

# - delete fzf_list_txt to rebuild listing.
# - save new formulae/casks names to present later in fzf.
# - delete the new names older than 3 days.
if [[ -f $names.$0:t-before.txt && -f $names.txt ]]
then
  new_keys=($( comm -1 -3 $names.$0:t-before.txt $names.txt ))
  names_new=$names.$0:t-new-$( print -- $new_keys[@] | md5 ).txt
  if [[ ${#new_keys} > 0 && ! -f $names_new ]]
  then
    printf "%s\n" $new_keys > $names_new
    rm -f $fzf_list_txt
  fi
  # clear new entries older than 3 days.
  for f in $names.$0:t-new-*.txt(Nm+3); rm $f
fi
if [[ -f $names.txt ]]
then
  cp -f $names.txt $names.$0:t-before.txt
fi

# hash the names of files holding the `new` state and dir listings that would affect the list.
context=(
  $names.${0:t}-new-*(N:t:r)
  $( brew $(c.pkgdef --cellar --caskroom))/*(N:t)
  $( brew --prefix )/var/homebrew/$( c.pkgdef pinned pinned_casks )/*(N:t)
)
state=$( print -- $context[@] | md5 )

if [[ ! -f $fzf_list_txt || $state != $( sed '1!d' $fzf_list_txt ) ]]
then
  # Use associative arrays for O(1) lookup speed
  typeset -A map_installed map_new map_pinned

  if [[ $pkgdef == --formula ]]
  then
    installed_all=($( brew ls --formula ))
    installed=($( brew ls --installed-on-request ))
    dependencies=( ${installed_all:|installed} )
  else
    installed=($( brew ls --cask ))
  fi

  pins=($( brew --prefix )/var/homebrew/pinned/*(N:t) )
  new=($( cat $names.$0:t-new-*.txt(N) ))
  for i in $pins; map_pinned[$i]=📌
  for i in $new; map_new[$i]=⏰new.
  for i in $installed; map_installed[$i]=🍺installed.
  for i in $dependencies; map_installed[$i]=🌾dependency.

  lsdesc=$( brew desc $pkgdef --name "/.+/" )
  processed_desc=""

  # Process descriptions line by line efficiently
  while IFS= read -r line; do
    if [[ $line =~ ^.+: ]]
    then
      name=${line%%:*}
      desc=${line#*:}
      processed_desc+="$name:${map_pinned[$name]}${map_new[$name]}${map_installed[$name]}$desc\n"
    else
      processed_desc+="$line\n"
    fi
  done <<< "$lsdesc"
  printf "%s\n%s" $state "${processed_desc%'\n'}" > $fzf_list_txt
fi

fzf_list=$( sed '1d' $fzf_list_txt )

case $brew_args[1] in
  install)
    # Omit installed and dependencies when installing.
    fzf_list=$( print -- $fzf_list | grep -vE "(🍺installed|🌾dependency)\." )
  ;;
  uninstall)
    # Can't uninstall a dependency.
    fzf_list=$( print -- $fzf_list | grep -vE "🌾dependency\." )
  ;;
  unpin)
    # List only pinned formulae to unpin.
    pins=($( brew --prefix )/var/homebrew/pinned/*(N:t) )
    if (( ${#pins} == 0 ))
    then
      print "Nothing to unpin." >&2
      exit 1
    fi
    fzf_list=$( print -- $fzf_list | sed -nuE "/^(${(j[|])pins}):.*/p" )
  ;;
esac

# list installed formulae or casks for commands targeting them.
if (( $brew_commands_installed[(I)$brew_args[1]] ))
then
  typeset -a __fzf_list=( "==> Installed $(c.pkgdef Formulae Casks)" )
  while read -r l
  do
    if [[ ${l/*:/} =~ "^(📌|🍺|🌾).*" ]]
    then
      __fzf_list+=$l
    fi
  done < <( print -- $fzf_list )
  fzf_list=${(j[\n])__fzf_list}
fi

selected=($(
  print -- $fzf_list | fzf --header-lines=1 --prompt="brew $brew_args " \
  $( (( $no_multi[(I)$brew_args[1]] )) || printf --multi ) | grep -oE "^[^:]+"
))
if [[ -n $selected ]]
then
  # Write into history the command that would have been run directly.
  # Formatted with `setopt extended_history` in mind.
  printf ": %s:0;%s\n" $( date -j +%s ) "brew $brew_args $selected" >> $HISTFILE
  printf "\033[4m%s\033[0m\n" "brew $brew_args $selected"
  brew $brew_args $selected
fi
