#!/usr/bin/env zsh

cmd=${1:-run} supported_cmd=( run stop show cp rm update )

if (( $supported_cmd[(I)$cmd] ))
then
  if [[ -n $1 ]]
  then shift
  fi

  fzf_args=( --prompt="❯ ollama $cmd " --header-lines=1 )

  case $cmd in
    run)
      # ignore embedding models when running directly.
      list=$( ollama ls | grep -vi "-embed" )
    ;;
    stop)
      list=`ollama ps`
      fzf_args+=--multi
    ;;
    rm)
      list=$( ollama ls )
      fzf_args+=--multi
    ;;
    update)
      ollama ls | awk '(NR > 1) {print $1}' | while read model
      do
        print -- "Updating $model."
        ollama pull $model
      done
      exit $?
    ;;
    *)
      list=`ollama ls`
    ;;
  esac

  model=($( print -- $list | sort -V | fzf $fzf_args | cut -d ' ' -f1 ))

  if [[ -n $model ]]
  then
    print "ollama $cmd $model $@"
    ollama $cmd $model $@
  fi
else
  print "Unsupported command. $0:t only accepts the following:\n $supported_cmd" >&2
  exit 1
fi
