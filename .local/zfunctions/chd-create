#!/usr/bin/env zsh
#function chd-create {
  _brew_check rom-tools || return 1

  local zoutput output ztrash_source
  zparseopts -D -E -F - \
    {o,-output}:=zoutput \
    {t,-trash-source}=ztrash_source || return 1

  output=${zoutput[-1]}
  if [[ -n $output && ! -d $output ]]
  then
    printf "Output directory \`%s\` does not exist.\n" $output >&2
    return 1
  fi
  trap '[[ -d $tmpdir ]] && rm -rf $tmpdir; return 1' INT TERM QUIT

  local input name idir tmpdir

  for input in $@
  do
    name=${input:t:r}
    idir=${input:h}
    tmpdir=$( mktemp -dt $name )

    if file $input | grep -q 'UDF'
    then createtype=createdvd
    else createtype=createcd
    fi
    if chdman $createtype -i $input -o $tmpdir/$name.chd
    then
      if [[ ${input:e} == (cue|gdi) ]]
      then
        if mv -f $tmpdir/$name.chd ${output:-${idir:h}}
        then (( #ztrash_source )) && trash $idir
        fi
      else
        if mv -f $tmpdir/$name.chd ${output:-$idir}/$name.chd
        then (( #ztrash_source )) && trash $input; rm -rf $tmpdir
        fi
      fi
    fi
  done
