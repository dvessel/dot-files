#!/usr/bin/env zsh
#
# .zplugins - antidote plugins file
#
# This file is used by antidote to configure Zsh bundles. Bundles are just a
# fancy way of referring to Zsh utilities, frameworks, prompts, or plugins.
#
# Example: https://github.com/getantidote/zdotdir/blob/main/.zsh_plugins.txt

romkatv/powerlevel10k path:powerlevel10k.zsh-theme

# zsh auto completions.
mattmc3/ez-compinit
nilsonholger/osx-zsh-completions kind:fpath
ocodo/ollama_zsh_completion kind:fpath
zsh-users/zsh-completions path:src kind:fpath
dvessel/zsh-completion-generator

Aloxaf/fzf-tab
jeffreytse/zsh-vi-mode
marlonrichert/zsh-hist
mattmc3/zman

michel-kraemer/zsh-patina
zsh-users/zsh-autosuggestions
